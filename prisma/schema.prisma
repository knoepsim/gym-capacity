// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gym {
  id             String             @id
  name           String
  url            String             @unique
  provider       String             @default("clubconnector") // clubconnector | fitx
  unit           String             @default("persons") // persons | percent (FitX only reports a percentage)
  region         String? // federal state code, e.g. BW (drives the poll interval)
  city           String?
  active         Boolean            @default(true) // false: not polled (e.g. FitX studio not open yet)
  occupancy      Occupancy[]
  hourly         OccupancyHourly[]
  feedbacks      GymFeedback[]
  analyticsCache GymAnalyticsCache?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Occupancy {
  id        Int      @id @default(autoincrement())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  count     Int // Aktuelle Anzahl Personen
  maxCount  Int // Maximale Kapazität
  timestamp DateTime @default(now())

  @@index([gymId, timestamp])
  @@index([timestamp])
}

// Derived hourly rollup of the (ghost-corrected) occupancy. Raw rows in Occupancy stay the source of truth;
// this table only exists so long-range profiles do not rescan the whole raw history every few minutes.
model OccupancyHourly {
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hourStart DateTime // start of the hour (UTC)
  localDay  String // Europe/Berlin date, YYYY-MM-DD
  weekday   Int // calendar weekday of localDay (0 = Sunday), holidays are mapped at read time
  hour      Int // Europe/Berlin hour
  meanCount Float
  samples   Int
  maxCount  Int

  @@id([gymId, hourStart])
}

model GymFeedback {
  id             Int      @id @default(autoincrement())
  gymId          String
  gym            Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  occupancyCount Int? // raw counter value at submission time
  estimatedCount Int? // persons on site as estimated by the member (optional)
  waitTimeRating Int?
  densityRating  Int?
  wouldGoRating  Int?
  comment        String?
  sourcePath     String?
  refId          String? // ref link the member opened last; marks reports from trusted people
  ref            RefLink? @relation(fields: [refId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  activationId   Int? // device of that ref link the report came from
  activation     RefActivation? @relation(fields: [activationId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([gymId, createdAt])
  @@index([createdAt])
  @@index([refId])
  @@index([activationId])
}

// Named invite link (?ref=<id>) handed to trusted people so their reports can be told apart.
model RefLink {
  id        String        @id // 6 characters from A-Z, a-z, 1-9
  name      String // shown publicly next to the code (e.g. first name)
  note        String? // internal admin note, never sent to the public API
  deviceLimit Int             @default(2) // browsers that may activate this link
  createdAt   DateTime        @default(now())
  feedbacks   GymFeedback[]
  activations RefActivation[]
}

// One browser that opened a ref link. The random suffix is what the browser stores and sends (<refId>_<suffix>),
// so knowing the public code alone does not make a report trusted.
model RefActivation {
  id        Int           @id @default(autoincrement())
  refId     String
  ref       RefLink       @relation(fields: [refId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  index     Int // 1-based order of activation, shown as "Gerät n"
  suffix    String
  ip          String? // address the browser activated from (first X-Forwarded-For entry)
  userAgent   String?
  deviceModel String? // from client hints; only Chromium on Android reports it
  revokedAt   DateTime? // soft delete: the token stops counting, reports from it arrive without a ref
  createdAt DateTime      @default(now())
  feedbacks GymFeedback[]
  events    RefEvent[]

  @@unique([refId, index])
  @@unique([refId, suffix])
}

model GymAnalyticsCache {
  gymId                 String    @id
  gym                   Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceLatestTimestamp DateTime?
  payload               Json
  computedAt            DateTime  @updatedAt

  @@index([computedAt])
}

// Access log per device: 'activate' (link opened), 'visit' (site opened, at most every few minutes) and
// 'report' (feedback sent). The newest row is the device's last access.
model RefEvent {
  id           Int           @id @default(autoincrement())
  activationId Int
  activation   RefActivation @relation(fields: [activationId], references: [id], onDelete: Cascade)
  type         String
  createdAt    DateTime      @default(now())

  @@index([activationId, createdAt])
}
